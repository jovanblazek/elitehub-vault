{
  "name": "@elitehub/eddn-listener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --tsconfig ./tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/sentry.js dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "NODE_ENV=test vitest run"
  },
  "dependencies": {
    "@elitehub/eddn-contracts": "workspace:*",
    "@elitehub/queue-contracts": "workspace:*",
    "@elitehub/runtime-config": "workspace:*",
    "@sentry/node": "10.73.0",
    "@t3-oss/env-core": "0.13.11",
    "bullmq": "5.76.4",
    "zeromq": "6.7.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@elitehub/typescript-config": "workspace:*",
    "tsx": "4.23.13"
  }
}
